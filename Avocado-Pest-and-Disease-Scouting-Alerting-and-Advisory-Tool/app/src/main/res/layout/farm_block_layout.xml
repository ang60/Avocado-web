<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_7"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/farm_block_layout_logo_image_view"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_tree"
        android:background="@drawable/image_background_8"/>
    <TextView
        android:id="@+id/farm_block_layout_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:text="Block A"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/farm_block_layout_number_of_trees_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:text="45 Trees"/>

</LinearLayout>