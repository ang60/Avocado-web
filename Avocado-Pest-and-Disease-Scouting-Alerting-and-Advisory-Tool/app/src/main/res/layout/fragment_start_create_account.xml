<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:background="#F5F5F1">
        <ImageView
            android:id="@+id/fragment_start_create_account_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_farmer"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp" />
        <TextView
            android:id="@+id/fragment_start_create_account_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tell_us_about_you"
            android:textSize="24sp"
            android:textColor="#112A20"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/fragment_start_create_account_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/we_will_personalize_your_experience"
            android:textSize="16sp"
            android:textColor="#5C7778"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="64dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <TextView
                    android:id="@+id/fragment_start_create_account_your_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="First Name"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    android:background="@null">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fragment_start_create_account_first_name_text_input_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:background="@drawable/text_input_background_1"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <TextView
                    android:id="@+id/fragment_start_create_account_last_name_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last Name"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    android:background="@null">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fragment_start_create_account_last_name_text_input_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:background="@drawable/text_input_background_1"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <TextView
                    android:id="@+id/fragment_start_create_account_your_location_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/your_location"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    android:background="@null">
                    <AutoCompleteTextView
                        android:id="@+id/fragment_start_create_account_your_location_auto_complete_text_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:background="@drawable/text_input_background_1"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:visibility="gone"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <TextView
                    android:id="@+id/fragment_start_create_account_password_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Password"
                    android:textSize="13sp"
                    android:textColor="#6B7280"
                    android:layout_marginBottom="8dp"/>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:hintEnabled="false"
                    android:background="@null"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/fragment_start_create_account_password_text_input_edit_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:background="@drawable/text_input_background_1"
                        android:textSize="16sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <CheckBox
                    android:id="@+id/fragment_start_create_account_terms_of_service_check_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    app:buttonTint="@color/check_box_color_1"/>
                <TextView
                    android:id="@+id/fragment_start_create_account_by_continuing_you_agree_to_our_terms_of_service_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/by_continuing_you_agree_to_our_terms_of_service"
                    android:textSize="12sp"
                    android:textColor="#5C7778"
                    android:layout_marginBottom="32dp"/>
            </LinearLayout>
            <Button
                android:id="@+id/fragment_start_create_account_continue_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_background_3"
                android:foreground="@drawable/custom_ripple_1"
                android:text="@string/continue_"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/white" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/fragment_start_create_account_i_have_an_account_layout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/fragment_start_create_account_i_have_an_account_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/i_have_an_account"
                android:textSize="14sp"
                android:textColor="#5C7778"
                android:textAllCaps="true"
                android:textStyle="bold"
                android:gravity="center_horizontal|top" />
            <Button
                android:id="@+id/fragment_start_create_account_login_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:padding="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_background_1"
                android:foreground="@drawable/custom_ripple_1"
                android:text="@string/log_in"
                android:textSize="18sp"
                android:textColor="#1A3F30"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>