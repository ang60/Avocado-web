<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/file_audio_linear_layout"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_26"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/file_audio_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_studio_microphone" />
    <TextView
        android:id="@+id/file_audio_text_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="16sp"
        android:textColor="@color/sage"
        android:text="Photo taken of the avocado variety"
        android:textStyle="normal"/>
    <ImageView
        android:id="@+id/file_audio_cancel_image_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:src="@drawable/ic_clear_24dp"
        app:tint="@color/mist" />

</LinearLayout>