<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                app:trackThickness="12dp"
                app:trackCornerRadius="16dp"
                app:indicatorColor="#2E6A4F"
                android:progress="5"
                android:max="7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 5 of 7"
                android:textSize="14sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Disease Observation"
                android:textSize="28sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WERE ANY DISEASES OBSERVED?"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"/>
            <com.avocado.android.ui.views.RadioGroup
                android:id="@+id/fragment_record_step_5_yes_no_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <com.avocado.android.ui.views.RadioButtonFour
                    android:id="@+id/fragment_record_step_5_yes_radio_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:image="@drawable/ic_check"
                    app:text="Yes" />
                <com.avocado.android.ui.views.RadioButtonFive
                    android:id="@+id/fragment_record_step_5_no_radio_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:image="@drawable/ic_cross_mark"
                    app:text="No" />
            </com.avocado.android.ui.views.RadioGroup>
            <LinearLayout
                android:id="@+id/fragment_record_step_5_yes_linear_layout"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT DISEASES"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.FlowLinearLayout
                    android:id="@+id/fragment_record_step_5_diseases_observed_flow_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_anthracnose_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_brown_circle"
                        app:text="Anthracnose"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_black_spot_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_black_circle"
                        app:text="Black spot"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_phytophthora_root_rot_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_water_wave"
                        app:text="Phytophthora root rot"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_armillaria_root_rot_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_mushroom"
                        app:text="Armillaria root rot"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_sunblotch_viroid_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_bug"
                        app:text="Sunblotch viroid"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_cercospora_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_yellow_circle"
                        app:text="Cercospora spot"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_stem_end_rot_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_red_circle"
                        app:text="Stem end rot"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_avocado_scab_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_brown_square"
                        app:text="Avocado scab"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_bacterial_canker_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_bug"
                        app:text="Bacterial canker"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_disease_fruit_rot_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_fallen_leaf"
                        app:text="Fruit rot"/>
                </com.avocado.android.ui.views.FlowLinearLayout>
                <com.avocado.android.ui.views.RadioButtonThree
                    android:id="@+id/fragment_record_step_5_select_disease_i_dont_know_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:image="@drawable/ic_red_question_mark"
                    app:text="I don't know" />
                <LinearLayout
                    android:id="@+id/fragment_record_step_5_i_dont_know_linear_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:layout_gravity="center"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OTHER PRODUCTION CHALLENGES"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.FlowLinearLayout
                    android:id="@+id/fragment_record_step_5_other_production_challenges_flow_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_other_production_challenges_weeds_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_herb"
                        app:text="Weeds"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_other_production_challenges_nutrient_deficiency_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_high_voltage"
                        app:text="Nutrient deficiency"/>
                    <com.avocado.android.ui.views.CheckBoxOne
                        android:id="@+id/fragment_record_step_5_other_production_challenges_frost_damage_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_snowflake"
                        app:text="Frost damage"/>
                </com.avocado.android.ui.views.FlowLinearLayout>
                <com.avocado.android.ui.views.RadioButtonThree
                    android:id="@+id/fragment_record_step_5_other_production_challenges_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:image="@drawable/ic_plus"
                    app:text="Add other production challenge" />
                <LinearLayout
                    android:id="@+id/fragment_record_step_5_add_other_production_challenges_linear_layout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Added Challenges"
                        android:textSize="16sp"
                        android:textColor="#5C7778"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                    <com.avocado.android.ui.views.FlowLinearLayout
                        android:id="@+id/fragment_record_step_5_add_other_production_challenges_flow_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PLANT PART"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.AutoFitGridLayout
                    android:id="@+id/fragment_record_step_5_plant_part_affected_grid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:column_width="160dp"
                    app:horizontal_spacing="0dp"
                    app:vertical_spacing="0dp">
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_leaves_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_green_leaf"
                        app:text="Leaves" />
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_flowers_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_cherry_blossom_flower"
                        app:text="Flowers" />
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_fruits_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_avocado"
                        app:text="Fruits" />
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_branches_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_herb"
                        app:text="Branches" />
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_roots_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_potted_plant"
                        app:text="Roots" />
                    <com.avocado.android.ui.views.CheckBoxTwo
                        android:id="@+id/fragment_record_step_5_plant_part_affected_other_check_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_cross_mark"
                        app:text="Other" />
                </com.avocado.android.ui.views.AutoFitGridLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CROP STAGE"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.FlowRadioGroup
                    android:id="@+id/fragment_record_step_5_crop_stage_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_crop_stage_flowering_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_cherry_blossom_flower"
                        app:text="Flowering"/>
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_crop_stage_maturing_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_yellow_circle"
                        app:text="Maturing"/>
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_crop_stage_mature_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_avocado"
                        app:text="Mature"/>
                </com.avocado.android.ui.views.FlowRadioGroup>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DETECTION METHOD"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.FlowRadioGroup
                    android:id="@+id/fragment_record_step_5_detection_method_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_detection_method_self_observation_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_eye"
                        app:text="Self-observation"/>
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_detection_method_extension_officer_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_construction_worker"
                        app:text="Extension officer"/>
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_detection_method_agronomist_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_office_building"
                        app:text="Agronomist"/>
                    <com.avocado.android.ui.views.RadioButtonSix
                        android:id="@+id/fragment_record_step_5_detection_method_kephis_inspector_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_microscope"
                        app:text="KEPHIS inspector"/>
                </com.avocado.android.ui.views.FlowRadioGroup>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="bottom"
        android:background="@color/white">
        <Button
            android:id="@+id/fragment_record_step_5_back_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="#344054"
            android:textSize="18sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_back_24dp"
            app:iconGravity="textStart"
            app:iconTint="#344054"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_4"
            android:foreground="@drawable/custom_ripple_1"/>
        <Button
            android:id="@+id/fragment_record_step_5_continue_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            app:backgroundTint="@null"
            android:text="@string/continue_"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:icon="@drawable/ic_forward_24dp"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_3"
            android:foreground="@drawable/custom_ripple_1"/>
    </LinearLayout>
</LinearLayout>