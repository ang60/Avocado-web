<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textSize="28sp"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:padding="16dp"
                android:background="@drawable/layout_background_14">
                <ImageButton
                    android:id="@+id/fragment_main_settings_account_image_button"
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_marginEnd="16dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_farmer"
                    android:scaleType="fitCenter"
                    android:background="@drawable/image_background_1"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="32dp">
                    <TextView
                        android:id="@+id/fragment_main_settings_name_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Jane Wanjiru"
                        android:textSize="20sp"
                        android:textColor="#1A1A1A"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/fragment_main_settings_location_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="Kiambu County"
                        android:textSize="16sp"
                        android:textColor="@color/slate"
                        android:textStyle="normal" />
                    <TextView
                        android:id="@+id/fragment_main_settings_phone_number_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+254701234567"
                        android:textSize="16sp"
                        android:textColor="@color/slate"
                        android:textStyle="normal" />
                </LinearLayout>
                <TextView
                    android:id="@+id/fragment_main_settings_edit_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit"
                    android:textColor="@color/sage"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="LANGUAGE"
                android:textColor="#5C7778"
                android:textSize="16sp"
                android:textStyle="bold" />
            <com.avocado.android.ui.views.RadioGroup
                android:id="@+id/fragment_main_settings_language_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp">
                <com.avocado.android.ui.views.RadioButtonTen
                    android:id="@+id/fragment_main_settings_language_english_radio_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:text="@string/english"/>
                <com.avocado.android.ui.views.RadioButtonTen
                    android:id="@+id/fragment_main_settings_language_swahili_radio_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:text="@string/swahili"/>
            </com.avocado.android.ui.views.RadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="FARM MANAGEMENT"
                android:textColor="#5C7778"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_14">
                <LinearLayout
                    android:id="@+id/fragment_main_settings_manage_farms_linear_layout"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_avocado"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Manage Farms"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:visibility="gone"
                        android:id="@+id/fragment_main_settings_manage_farms_number_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Farms"
                        android:textColor="@color/mist"
                        android:textSize="16sp"
                        android:textStyle="normal"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/mist"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/fragment_main_settings_manage_blocks_linear_layout"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_flag_in_hole"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Manage Blocks"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:visibility="gone"
                        android:id="@+id/fragment_main_settings_manage_blocks_number_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 Blocks"
                        android:textColor="@color/mist"
                        android:textSize="16sp"
                        android:textStyle="normal"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/mist"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATIONS"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_14">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_bell"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Weekly Reminders"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/fragment_main_settings_notifications_weekly_reminders_switch_compat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:thumbTint="@color/switch_color_1"
                        app:trackTint="@color/switch_color_2"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_speech_balloon"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SMS Alerts"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/fragment_main_settings_notifications_sms_alerts_switch_compat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:thumbTint="@color/switch_color_1"
                        app:trackTint="@color/switch_color_2"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_farmer"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Receive Agronomist Alerts"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/fragment_main_settings_notifications_receive_agronomist_alerts_switch_compat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:thumbTint="@color/switch_color_1"
                        app:trackTint="@color/switch_color_2"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FARM MANAGER ROLE"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_14">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_memo"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Take Records"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <CheckBox
                        android:id="@+id/fragment_main_settings_farmer_manager_role_take_records_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/check_box_color_1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_bar_chart"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Send Survey"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <CheckBox
                        android:id="@+id/fragment_main_settings_farmer_manager_role_send_survey_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/check_box_color_1"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_farmer"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Receive Agronomist Alerts"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <CheckBox
                        android:id="@+id/fragment_main_settings_farmer_manager_role_receive_agronomist_alerts_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        app:buttonTint="@color/check_box_color_1"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HELP"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_14">
                <LinearLayout
                    android:id="@+id/fragment_main_settings_help_how_to_use_linear_layout"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_red_question_mark"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="How to Use"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/mist"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/fragment_main_settings_help_knowledge_base_linear_layout"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="32dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_books"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Knowledge Base"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/mist"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/fragment_main_settings_help_contact_support_linear_layout"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_telephone_receiver"/>
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Contact Support"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/mist"/>
                </LinearLayout>
            </LinearLayout>
            <Button
                android:id="@+id/fragment_main_settings_log_out_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="16dp"
                android:padding="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_background_5"
                android:foreground="@drawable/custom_ripple_1"
                android:text="Log Out"
                android:textSize="18sp"
                android:textColor="@color/danger_border"
                android:textAllCaps="false"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>