<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_button_sixteen_linear_layout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_6"
    android:gravity="center">

    <ImageView
        android:id="@+id/radio_button_sixteen_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="10dp"
        android:src="@drawable/ic_tree"
        android:background="@drawable/image_background_8"/>
    <TextView
        android:id="@+id/radio_button_sixteen_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:text="Block A"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/radio_button_sixteen_sub_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#6B7280"
        android:text="45 Trees"/>

</LinearLayout>