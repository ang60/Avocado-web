<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:background="#F5F5F1">
        <ImageView
            android:id="@+id/fragment_start_create_account_image"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_note"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="24dp" />
        <TextView
            android:id="@+id/fragment_start_create_account_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Role"
            android:textSize="24sp"
            android:textColor="#112A20"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>
        <TextView
            android:id="@+id/fragment_start_create_account_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your role on the farm"
            android:textSize="16sp"
            android:textColor="#5C7778"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"/>
        <com.avocado.android.ui.views.RadioGroup
            android:id="@+id/fragment_start_select_role_radio_group"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="64dp">
            <com.avocado.android.ui.views.RadioButtonTwelve
                android:id="@+id/fragment_start_select_role_farmer_radio_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:image="@drawable/ic_farmer"
                app:title="Farmer"
                app:sub_title="Owner and decision maker of the farm. Who will be recording data"/>
            <com.avocado.android.ui.views.RadioButtonTwelve
                android:id="@+id/fragment_start_select_role_farm_manager_radio_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:image="@drawable/ic_farmer"
                app:title="Farm Manager"
                app:sub_title="Assigned by the farmer to take farm record"/>
        </com.avocado.android.ui.views.RadioGroup>
        <LinearLayout
            android:id="@+id/fragment_start_create_account_i_have_an_account_layout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="bottom">
            <Button
                android:id="@+id/fragment_start_select_role_continue_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_background_3"
                android:foreground="@drawable/custom_ripple_1"
                android:text="@string/continue_"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>