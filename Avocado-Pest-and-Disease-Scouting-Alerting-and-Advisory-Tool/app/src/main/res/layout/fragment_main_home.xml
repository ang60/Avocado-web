<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#F5F5F1">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">
            <ImageButton
                android:id="@+id/fragment_main_home_account_image_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:padding="12dp"
                android:src="@drawable/ic_farmer"
                android:scaleType="fitCenter"
                android:background="@drawable/image_background_1"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="32dp">
                <TextView
                    android:id="@+id/fragment_main_home_account_name_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Jane Wanjiru"
                    android:textSize="20sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/fragment_main_home_account_location_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kiambu County"
                    android:textSize="16sp"
                    android:textColor="@color/slate"
                    android:textStyle="normal" />
            </LinearLayout>
            <androidx.coordinatorlayout.widget.CoordinatorLayout
                android:layout_width="44dp"
                android:layout_height="44dp">
                <ImageButton
                    android:id="@+id/fragment_main_home_alert_image_button"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_bell"
                    android:scaleType="fitCenter"
                    android:background="@drawable/image_background_2"/>
                <RelativeLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/badge_background_1"
                    app:layout_anchor="@id/fragment_main_home_alert_image_button"
                    app:layout_anchorGravity="top|end">
                    <TextView
                        android:id="@+id/fragment_main_home_alert_count_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:text="0"
                        android:layout_centerInParent="true"/>
                </RelativeLayout>
            </androidx.coordinatorlayout.widget.CoordinatorLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/layout_background_1"
            android:layout_marginBottom="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="@color/mist"
                android:text="THIS WEEK'S BLOCK RECORDS"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:id="@+id/fragment_main_home_block_records_count_text_view"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="32sp"
                    android:textColor="#1A1A1A"
                    android:textStyle="bold"
                    android:text="0 of 5"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:id="@+id/fragment_main_home_block_records_percentage_text_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    android:textColor="#2E6A4F"
                    android:textStyle="bold"
                    android:text="0%" />
            </LinearLayout>
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/fragment_main_home_block_records_progress_bar"
                app:trackThickness="12dp"
                app:trackCornerRadius="16dp"
                app:indicatorColor="#2E6A4F"
                android:progress="0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <Button
                android:id="@+id/fragment_main_home_continue_recording_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                app:backgroundTint="@null"
                android:background="@drawable/button_background_3"
                android:foreground="@drawable/custom_ripple_1"
                android:text="@string/continue_recording"
                android:textSize="18sp"
                android:textColor="@color/white"
                android:textAllCaps="false"
                app:icon="@drawable/ic_pencil_18dp"
                app:iconGravity="textStart"
                app:iconTint="@null" />
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="16sp"
                android:textColor="@color/mist"
                android:text="PENDING ADVISORY"
                android:textStyle="bold" />
            <Button
                android:id="@+id/fragment_main_home_pending_advisory_see_all_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E6A4F"
                android:textSize="16sp"
                android:text="@string/see_all"
                android:textAllCaps="false"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconTint="#2E6A4F"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp">
            <ProgressBar
                android:id="@+id/fragment_main_home_pending_advisory_progress_bar"
                android:layout_margin="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <LinearLayout
                android:id="@+id/fragment_main_home_pending_advisory_linear_layout"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_2"
                android:gravity="center_vertical"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/fragment_main_home_pending_advisory_logo_image_view"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:padding="16dp"
                    android:src="@drawable/ic_fallen_leaf"
                    android:background="@drawable/image_background_3"
                    android:layout_marginEnd="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#93370D"
                        android:text="@string/pending_advisory"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/fragment_main_home_pending_advisory_title_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="20sp"
                        android:textColor="@color/black"
                        android:text="Action Needed"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:id="@+id/fragment_main_home_pending_advisory_sub_title_text_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#93370D"
                        android:text="Farm • Block"
                        android:textStyle="normal" />
                </LinearLayout>
                <ImageButton
                    android:id="@+id/fragment_main_home_pending_advisory_next_image_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#93370D"
                    android:background="@drawable/image_background_4"/>
            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textColor="#1A1A1A"
                android:text="Alerts"
                android:textStyle="bold" />
            <Button
                android:id="@+id/fragment_main_home_alerts_see_all_button"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#2E6A4F"
                android:textSize="16sp"
                android:text="@string/see_all"
                android:textAllCaps="false"
                app:icon="@drawable/ic_arrow_right"
                app:iconGravity="textEnd"
                app:iconTint="#2E6A4F"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/fragment_main_home_alerts_progress_bar"
                android:layout_margin="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fragment_main_home_alerts_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </RelativeLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>