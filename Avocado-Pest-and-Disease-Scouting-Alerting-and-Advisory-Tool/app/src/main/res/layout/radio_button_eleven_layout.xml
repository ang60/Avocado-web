<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_button_eleven_linear_layout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_7"
    android:gravity="center_horizontal">

    <ImageView
        android:id="@+id/radio_button_eleven_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:padding="10dp"
        android:src="@drawable/ic_camera"
        android:background="@drawable/image_background_8"/>
    <TextView
        android:id="@+id/radio_button_eleven_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textColor="#1A1A1A"
        android:text="Take Photo"
        android:textStyle="bold"
        android:textAlignment="center"/>

</LinearLayout>