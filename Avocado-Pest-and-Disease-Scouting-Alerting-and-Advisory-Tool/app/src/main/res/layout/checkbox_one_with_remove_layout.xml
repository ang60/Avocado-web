<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/checkbox_one_with_remove_linear_layout"
    android:orientation="horizontal"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_12"
    android:gravity="center">

    <ImageView
        android:id="@+id/checkbox_one_with_remove_image"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="4dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_black_circle" />
    <TextView
        android:id="@+id/checkbox_one_with_remove_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/ink"
        android:text="Checkbox"
        android:textStyle="normal"/>
    <ImageView
        android:id="@+id/checkbox_one_with_remove_clear_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_clear_24dp"
        android:layout_gravity="center_vertical|end"/>

</LinearLayout>