<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report a Problem"
                android:textSize="28sp"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@drawable/layout_background_3"
                android:layout_marginBottom="32dp">
                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_light_bulb"
                    android:background="@drawable/image_background_5"
                    android:layout_marginEnd="16dp" />
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#1D2939"
                        android:text="@string/what_to_do"
                        android:textStyle="normal"
                        android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#1A1A1A"
                        android:text="For urgent issues between weekly records. Quick — under 1 minute."
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WHAT'S THE PROBLEM?"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>
            <com.avocado.android.ui.views.RecursiveRadioGroup
                android:id="@+id/activity_report_problem_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <com.avocado.android.ui.views.AutoFitGridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:column_width="160dp"
                    app:horizontal_spacing="0dp"
                    app:vertical_spacing="0dp">
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_pest_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_bug"
                        app:text="Pest" />
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_disease_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_fallen_leaf"
                        app:text="Disease" />
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_water_issue_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_droplet"
                        app:text="Water Issue" />
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_weather_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_thermometer"
                        app:text="Weather" />
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_animal_or_bird_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_eagle"
                        app:text="Animal/Bird" />
                    <com.avocado.android.ui.views.RadioButtonOne
                        android:id="@+id/activity_report_problem_other_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:image="@drawable/ic_cross_mark"
                        app:text="Other" />
                </com.avocado.android.ui.views.AutoFitGridLayout>
            </com.avocado.android.ui.views.RecursiveRadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOW URGENT?"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"/>
            <com.avocado.android.ui.views.RecursiveRadioGroup
                android:id="@+id/activity_report_urgent_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.avocado.android.ui.views.AutoFitGridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:column_width="160dp"
                    app:horizontal_spacing="0dp"
                    app:vertical_spacing="0dp">
                    <com.avocado.android.ui.views.RadioButtonEight
                        android:id="@+id/activity_report_how_urgent_low_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:text="Low"
                        app:highlight_background="@drawable/layout_background_7" />
                    <com.avocado.android.ui.views.RadioButtonEight
                        android:id="@+id/activity_report_how_urgent_medium_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:text="Medium"
                        app:highlight_background="@drawable/layout_background_17" />
                    <com.avocado.android.ui.views.RadioButtonEight
                        android:id="@+id/activity_report_how_urgent_urgent_radio_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:text="Urgent!"
                        app:highlight_background="@drawable/layout_background_18" />
                </com.avocado.android.ui.views.AutoFitGridLayout>
            </com.avocado.android.ui.views.RecursiveRadioGroup>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAKE A PHOTO"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"/>
            <com.avocado.android.ui.views.RadioButtonSeven
                android:id="@+id/activity_report_problem_take_a_photo_radio_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:image="@drawable/ic_camera"
                app:text="Tap to photograph the problem" />
            <LinearLayout
                android:id="@+id/activity_report_problem_take_a_photo_linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"
                android:gravity="center"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DESCRIBE THE PROBLEM"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="8dp"/>
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:hintEnabled="false"
                android:background="@null">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/activity_report_problem_describe_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:inputType="textMultiLine"
                    android:background="@drawable/text_input_background_1"
                    android:textColor="@color/edit_text_color"
                    android:textSize="16sp"
                    android:hint="What did you see? Where on the farm?"
                    android:gravity="top"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="bottom"
        android:background="@color/white">
        <Button
            android:id="@+id/activity_report_submit_report_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:padding="12dp"
            app:backgroundTint="@null"
            android:text="Submit Report"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:icon="@drawable/ic_forward_24dp"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_3"
            android:foreground="@drawable/custom_ripple_1"/>
    </LinearLayout>
</LinearLayout>