<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_button_thirteen_linear_layout"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_15"
    android:gravity="center">

    <ImageView
        android:id="@+id/radio_button_thirteen_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_camera" />
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/radio_button_thirteen_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textColor="@color/sage"
            android:text="Other Trap"
            android:textStyle="normal"/>
        <TextView
            android:id="@+id/radio_button_thirteen_sub_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/sage"
            android:text="Take a photo of the trap"
            android:textStyle="normal"/>
    </LinearLayout>

</LinearLayout>