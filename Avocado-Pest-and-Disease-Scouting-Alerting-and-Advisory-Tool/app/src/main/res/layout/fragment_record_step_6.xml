<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                app:trackThickness="12dp"
                app:trackCornerRadius="16dp"
                app:indicatorColor="#2E6A4F"
                android:progress="6"
                android:max="7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 6 of 7"
                android:textSize="14sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Control Actions"
                android:textSize="28sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ACTION STATUS"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.RadioGroup
                    android:id="@+id/fragment_record_step_6_action_status_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">
                    <com.avocado.android.ui.views.RadioButtonFour
                        android:id="@+id/fragment_record_step_6_actions_completed_radio_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:image="@drawable/ic_check"
                        app:text="Actions Completed" />
                    <com.avocado.android.ui.views.RadioButtonFifteen
                        android:id="@+id/fragment_record_step_6_pending_actions_radio_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:image="@drawable/ic_hour_glass"
                        app:text="Pending Actions" />
                </com.avocado.android.ui.views.RadioGroup>
                <LinearLayout
                    android:id="@+id/fragment_record_step_6_action_status_linear_layout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACTIONS TAKEN"
                        android:textSize="16sp"
                        android:textColor="#5C7778"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"/>
                    <com.avocado.android.ui.views.FlowLinearLayout
                        android:id="@+id/fragment_record_step_6_action_taken_flow_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_farms_sanitation_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_herb"
                            app:text="Farm sanitation"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_pruning_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_scissors"
                            app:text="Pruning"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_traps_installed_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_mouse_trap"
                            app:text="Traps installed"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_traps_serviced_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_wrench"
                            app:text="Traps serviced"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_chemical_control_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_pill"
                            app:text="Chemical control"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_biological_control_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_lady_beetle"
                            app:text="Biological control"/>
                        <com.avocado.android.ui.views.CheckBoxOne
                            android:id="@+id/fragment_record_step_6_action_taken_no_action_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:image="@drawable/ic_cross_mark"
                            app:text="No action taken"/>
                    </com.avocado.android.ui.views.FlowLinearLayout>
                    <LinearLayout
                        android:id="@+id/fragment_record_step_6_chemical_control_linear_layout"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:padding="16dp"
                        android:background="@drawable/layout_background_14">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRODUCT NAME"
                            android:textSize="16sp"
                            android:textColor="#5C7778"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginTop="0dp"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            app:hintEnabled="false"
                            android:background="@null">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/fragment_record_step_6_action_taken_chemical_control_product_name_edit_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:background="@drawable/text_input_background_1"
                                android:textColor="@color/edit_text_color"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE INGREDIENT"
                            android:textSize="16sp"
                            android:textColor="#5C7778"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            app:hintEnabled="false"
                            android:background="@null">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/fragment_record_step_6_action_taken_chemical_control_active_ingredient_edit_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:background="@drawable/text_input_background_1"
                                android:textColor="@color/edit_text_color"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TREES TREATED"
                            android:textSize="16sp"
                            android:textColor="#5C7778"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"/>
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            app:hintEnabled="false"
                            android:background="@null">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/fragment_record_step_6_action_taken_chemical_control_trees_treated_edit_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:background="@drawable/text_input_background_1"
                                android:textColor="@color/edit_text_color"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTCOME"
                        android:textSize="16sp"
                        android:textColor="#5C7778"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                    <com.avocado.android.ui.views.RecursiveRadioGroup
                        android:id="@+id/fragment_record_step_6_outcome_radio_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.avocado.android.ui.views.AutoFitGridLayout
                            android:id="@+id/fragment_record_step_6_outcome_grid_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:column_width="160dp"
                            app:horizontal_spacing="0dp"
                            app:vertical_spacing="0dp">
                            <com.avocado.android.ui.views.RadioButtonFour
                                android:id="@+id/fragment_record_step_6_outcome_controlled_radio_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:image="@drawable/ic_check"
                                app:text="Controlled" />
                            <com.avocado.android.ui.views.RadioButtonFour
                                android:id="@+id/fragment_record_step_6_outcome_reduced_radio_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:image="@drawable/ic_chart_decreasing"
                                app:text="Reduced" />
                            <com.avocado.android.ui.views.RadioButtonFour
                                android:id="@+id/fragment_record_step_6_outcome_still_present_radio_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:image="@drawable/ic_warning"
                                app:text="Still present" />
                            <com.avocado.android.ui.views.RadioButtonFour
                                android:id="@+id/fragment_record_step_6_outcome_follow_up_needed_radio_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:image="@drawable/ic_counterclockwise_arrows"
                                app:text="Follow-up needed" />
                        </com.avocado.android.ui.views.AutoFitGridLayout>
                    </com.avocado.android.ui.views.RecursiveRadioGroup>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REMARKS"
                        android:textSize="16sp"
                        android:textColor="#5C7778"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"/>
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:hintEnabled="false"
                        android:background="@null">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fragment_record_step_6_remarks_edit_text"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:background="@drawable/text_input_background_1"
                            android:gravity="top"
                            android:hint="Any additional observations..."
                            android:inputType="textMultiLine"
                            android:textColor="@color/edit_text_color"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="bottom"
        android:background="@color/white">
        <Button
            android:id="@+id/fragment_record_step_6_back_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="#344054"
            android:textSize="18sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_back_24dp"
            app:iconGravity="textStart"
            app:iconTint="#344054"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_4"
            android:foreground="@drawable/custom_ripple_1"/>
        <Button
            android:id="@+id/fragment_record_step_6_continue_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            app:backgroundTint="@null"
            android:text="@string/continue_"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:icon="@drawable/ic_forward_24dp"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_3"
            android:foreground="@drawable/custom_ripple_1"/>
    </LinearLayout>
</LinearLayout>