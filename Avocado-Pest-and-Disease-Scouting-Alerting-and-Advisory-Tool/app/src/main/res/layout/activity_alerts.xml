<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alerts"
                android:textSize="28sp"
                android:textColor="@color/ink"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="end">
                <Button
                    android:id="@+id/activity_alerts_mark_all_read_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sage"
                    android:textSize="16sp"
                    android:text="Mark all read"
                    android:textAllCaps="false" />
            </LinearLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <com.avocado.android.ui.views.RadioGroup
                    android:id="@+id/activity_alerts_categories_radio_group"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <com.avocado.android.ui.views.RadioButtonNine
                        android:id="@+id/activity_alerts_categories_all_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="All"/>
                    <com.avocado.android.ui.views.RadioButtonNine
                        android:id="@+id/activity_alerts_categories_unread_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="Unread"/>
                    <com.avocado.android.ui.views.RadioButtonNine
                        android:id="@+id/activity_alerts_categories_warn_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="Warn"/>
                    <com.avocado.android.ui.views.RadioButtonNine
                        android:id="@+id/activity_alerts_categories_urgent_radio_button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:text="Urgent"/>
                </com.avocado.android.ui.views.RadioGroup>
            </HorizontalScrollView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/activity_alerts_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                tools:listitem="@layout/alerts_layout"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>