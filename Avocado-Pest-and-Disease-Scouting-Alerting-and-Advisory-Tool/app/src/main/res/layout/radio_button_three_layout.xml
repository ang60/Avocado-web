<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radio_button_three_linear_layout"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:layout_margin="8dp"
    android:background="@drawable/layout_background_10"
    android:gravity="center">

    <ImageView
        android:id="@+id/radio_button_three_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="4dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_red_question_mark" />
    <TextView
        android:id="@+id/radio_button_three_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textColor="@color/orange_text"
        android:text="I don't know"
        android:textStyle="normal"/>

</LinearLayout>