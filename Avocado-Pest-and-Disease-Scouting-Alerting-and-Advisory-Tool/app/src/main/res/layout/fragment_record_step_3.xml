<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F1">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progress_bar"
                app:trackThickness="12dp"
                app:trackCornerRadius="16dp"
                app:indicatorColor="#2E6A4F"
                android:progress="3"
                android:max="7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 3 of 7"
                android:textSize="14sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pest Observation"
                android:textSize="28sp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WERE ANY PESTS OBSERVED?"
                android:textSize="16sp"
                android:textColor="#5C7778"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"/>
            <com.avocado.android.ui.views.RadioGroup
                android:id="@+id/fragment_record_step_3_were_any_pests_yes_no_radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <com.avocado.android.ui.views.RadioButtonFour
                    android:id="@+id/fragment_record_step_3_were_any_pests_observed_yes_radio_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:image="@drawable/ic_check"
                    app:text="Yes" />
                <com.avocado.android.ui.views.RadioButtonFive
                    android:id="@+id/fragment_record_step_3_were_any_pests_observed_no_radio_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:image="@drawable/ic_cross_mark"
                    app:text="No" />
            </com.avocado.android.ui.views.RadioGroup>
            <LinearLayout
                android:id="@+id/fragment_record_step_3_yes_linear_layout"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SELECT PESTS OBSERVED"
                    android:textSize="16sp"
                    android:textColor="#5C7778"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="8dp"/>
                <com.avocado.android.ui.views.AutoFitGridLayout
                    android:id="@+id/fragment_record_step_3_pests_observed_grid_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:column_width="176dp"
                    app:horizontal_spacing="0dp"
                    app:vertical_spacing="0dp">
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_melon_fly_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/melon_fruit_fly"
                        app:title="Melon fly"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_persea_mites_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/persea_mites"
                        app:title="Persea mites"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_fig_wax_scale_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/fig_wax_scale"
                        app:title="Fig wax scale"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_white_fly_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/whitefly"
                        app:title="White fly"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_red_wax_scale_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/red_wax_scale"
                        app:title="Red wax scale"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_mediterranean_fruit_fly_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/mediterranean_fruit_fly"
                        app:title="Mediterranean fruit fly"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_natal_fruit_fly_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@mipmap/natal_fruit_fly"
                        app:title="Natal fruit fly"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_thrips_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_no_image"
                        app:title="Thrips"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_caterpillars_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_no_image"
                        app:title="Caterpillars"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_mango_fruit_fly_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_no_image"
                        app:title="Mango fruit fly"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_broad_mite_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_no_image"
                        app:title="Broad mite"
                        app:sub_title="0/Trap"/>
                    <com.avocado.android.ui.views.CheckBoxThree
                        android:id="@+id/fragment_record_step_3_pests_observed_shot_hole_borer_check_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:image="@drawable/ic_no_image"
                        app:title="Shot-hole borer"
                        app:sub_title="0/Trap"/>
                </com.avocado.android.ui.views.AutoFitGridLayout>
                <com.avocado.android.ui.views.RadioButtonSeven
                    android:id="@+id/fragment_record_step_3_pests_observed_add_other_pest_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:image="@drawable/ic_plus"
                    app:text="Add Other Pest" />
                <com.avocado.android.ui.views.RadioButtonThree
                    android:id="@+id/fragment_record_step_3_pests_observed_i_dont_know_radio_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:image="@drawable/ic_red_question_mark"
                    app:text="I don't know" />
                <LinearLayout
                    android:id="@+id/fragment_record_step_3_pests_observed_i_dont_know_linear_layout"
                    android:orientation="vertical"
                    android:layout_marginTop="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="bottom"
        android:background="@color/white">
        <Button
            android:id="@+id/fragment_record_step_3_back_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="#344054"
            android:textSize="18sp"
            app:backgroundTint="@null"
            app:icon="@drawable/ic_back_24dp"
            app:iconGravity="textStart"
            app:iconTint="#344054"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_4"
            android:foreground="@drawable/custom_ripple_1"/>
        <Button
            android:id="@+id/fragment_record_step_3_continue_button"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:padding="12dp"
            app:backgroundTint="@null"
            android:text="@string/continue_"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:textAllCaps="false"
            app:icon="@drawable/ic_forward_24dp"
            app:iconGravity="textEnd"
            app:iconTint="@color/white"
            app:cornerRadius="16dp"
            android:elevation="1dp"
            android:background="@drawable/button_background_3"
            android:foreground="@drawable/custom_ripple_1"/>
    </LinearLayout>
</LinearLayout>