<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="32dp"
        android:background="#F5F5F1"
        android:gravity="center_vertical">
        <RelativeLayout
            android:id="@+id/fragment_start_success_welcome_layout"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/logo_background_3"
            android:layout_marginBottom="32dp">
            <ImageView
                android:id="@+id/fragment_start_success_welcome_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_check"
                android:layout_centerInParent="true" />
        </RelativeLayout>
        <TextView
            android:id="@+id/fragment_start_success_title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/successful"
            android:textSize="28sp"
            android:textColor="#2E6A4F"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="32dp"/>
        <TextView
            android:id="@+id/fragment_start_success_subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/your_account_has_been_created_successfully"
            android:textSize="16sp"
            android:textColor="#5C7778"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"/>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>