# --- Local dev (recommended) ---
# Proxy avoids CORS when the SPA runs on localhost and the API is on Vercel.
VITE_API_USE_PROXY=true
VITE_API_PROXY_TARGET=https://avo-guard.vercel.app
VITE_API_BASE_URL=

# --- Direct API URL (only if CORS allows your dev origin on Vercel) ---
# VITE_API_USE_PROXY=false
# VITE_API_BASE_URL=https://avo-guard.vercel.app

# --- Production build (static host → Vercel API) ---
# VITE_API_BASE_URL=https://avo-guard.vercel.app
# VITE_API_USE_PROXY=false
