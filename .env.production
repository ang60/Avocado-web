# Copy to `.env.production` in this repo root, then run: npm run build
# Vite bakes this in at build time — the browser never uses localhost in production.
#
# Use the public URL where your Django API is reachable (HTTPS, no trailing slash):
# - Same site with reverse proxy: https://avoguard.cognitron.co.ke
# - API subdomain: https://api.cognitron.co.ke
VITE_API_BASE_URL=http://avoguard.cognitron.co.ke
